  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language",
            "description": "ISO code like 'en' or 'hi'; omit to auto-detect"
          }
        },
        "type": "object",
        "title": "AnalyzeRequest"
      },
      "Container": {
        "type": "string",
        "enum": [
          "mp4",
          "mov",
          "mkv",
          "webm",
          "avi"
        ],
        "title": "Container"
      },
      "EditingMode": {
        "type": "string",
        "enum": [
          "auto",
          "highlight",
          "funny",
          "cinematic",
          "viral",
          "minimal"
        ],
        "title": "EditingMode"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestRequest": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "Absolute path to a local video file (local mode only)"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "project_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Name"
          },
          "mode": {
            "$ref": "#/components/schemas/EditingMode",
            "default": "auto"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "IngestRequest"
      },
      "IngestResponse": {
        "properties": {
          "project": {
            "$ref": "#/components/schemas/ProjectOut"
          },
          "asset": {
            "$ref": "#/components/schemas/MediaAssetOut"
          },
          "checksum_job": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobOut"
              },
